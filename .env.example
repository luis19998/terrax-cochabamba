# Copy this file to .env and fill in the values. .env is never committed.

# GAMC geoservices (project 04, "Adapting Farms with NASA Data").
# The key is shown in https://recursosgamc.cochabamba.bo/api-doc
GAMC_WMS_URL=https://serviciosgamc.cochabamba.bo/api/gs/wms
GAMC_API_KEY=

# Language model for Terra (optional: without a key Terra answers from fixed rules).
# Gemini is used first when its key is set; GEMINI_MODEL is optional (the newest "flash" model is chosen).
GEMINI_API_KEY=
GEMINI_MODEL=
ANTHROPIC_API_KEY=

# Optional: accounts to keep each person's plots in the cloud (Supabase). The publishable key is public by design;
# the table has row level security. Without these two, plots stay only on the device.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Messages that Yatiri X sends on its own (WhatsApp alerts and weekly summary).
# ALERTS_SECRET protects /api/n8n/* and /api/alerts/run; put the same phrase in the n8n credential.
# ALERTS_SENDER=n8n when the n8n workflows send (the Netlify daily schedule then stays quiet).
ALERTS_SECRET=
ALERTS_SENDER=
# Optional: Gemini model for the Quechua translation of the web (default gemini-3.5-flash).
TRANSLATE_MODEL=
