              "batchInterval": 1200
            }
          },
          "response": {
            "response": {
              "neverError": true
            }
          },
          "timeout": 15000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "name": "WhatsApp Cloud API: token (Authorization)"
        }
      },
      "notes": "Un mensaje por segundo para respetar los límites de Meta. Si Meta rechaza uno, se anota y sigue con los demás."
    },
    {
      "id": "61b5d901-46c8-4490-a81c-e6066a4d8ccb",
      "name": "Nota",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {
        "content": "## Resumen semanal\nCada lunes a las 7:00 envía a cada persona suscrita: días con lluvia y heladas de la semana, lluvia frente a lo normal, cómo suele ser el mes y un consejo. En su idioma (castellano o quechua).",
        "width": 460,
        "height": 300
      }
    }
